<?xml version="1.0" encoding="utf-8"?>
<!-- Reglas de extracción de datos (Android 12+) para copia en la nube y transferencia. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
