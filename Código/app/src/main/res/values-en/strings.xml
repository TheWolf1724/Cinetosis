    <string name="onb_intro_title">Welcome to Cinetosis</string>
    <string name="onb_intro_body">Cinetosis reduces car sickness by showing dots at the edges of the screen that move in real time with the vehicle\'s acceleration. This way what you see matches what your body feels.</string>

    <string name="onb_overlay_title">Permission: display over other apps</string>
    <string name="onb_overlay_body">To draw the dots over any app (maps, reading, video…), Cinetosis needs the “Display over other apps” permission.</string>

    <string name="onb_notif_title">Permission: notifications</string>
    <string name="onb_notif_body">While the cues are active, a persistent notification keeps the service running. Allow notifications so it works properly.</string>
    <string name="onb_notif_button">Allow notifications</string>

    <string name="onb_tile_title">Quick tile</string>
    <string name="onb_tile_body">Add a button to your Quick Settings (like the Wi-Fi one) to turn the cues on and off without opening the app.</string>
    <string name="onb_tile_button">Add quick tile</string>
    <string name="onb_tile_manual">On your Android version, add the “Cinetosis” tile manually from the Quick Settings editor.</string>

    <string name="onb_battery_title">Battery &amp; autostart</string>
    <string name="onb_battery_body">For auto-on while driving to always work, allow Cinetosis to ignore battery optimization. On some phones (Xiaomi, Huawei, Samsung…) you must also enable the app\'s “autostart” in the system settings.</string>
    <string name="onb_battery_button">Allow</string>

    <string name="onb_finish_title">All set!</string>
    <string name="onb_finish_body">Place your phone where you\'ll look during the trip and turn on the cues. Have a good trip!</string>

